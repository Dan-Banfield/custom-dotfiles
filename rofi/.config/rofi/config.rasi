configuration {
    modi: "drun,run,window";
    show-icons: false;
    drun-display-format: "{name} {comment}";
    disable-history: false;
    sidebar-mode: false;
    display-drun: "Applications";
}

@theme "/dev/null"

* {
    bg:          #1a1a1c;
    bg-alt:      #212124;
    fg:          #ffffff;
    fg-alt:      #8a8a93;
    accent:      #3d4c57;
    border-col:  #49454e;
    lavender:    #cec2db;

    background-color: transparent;
    text-color:       @fg;
    margin:           0;
    padding:          0;
    spacing:          0;
}

window {
    width:            50%;
    border:           2px;
    border-color:     @border-col;
    background-color: @bg;
}

mainbox {
    children: [ inputbar, listview ];
}

inputbar {
    padding:      12px;
    border:       0 0 2px 0;
    border-color: @border-col;
    children:     [ prompt, entry, num-filtered-rows ];
}

prompt {
    text-color: @fg;
    padding:    0 8px 0 0;
}

entry {
    text-color:        @fg;
    placeholder:       "Type to search...";
    placeholder-color: @fg-alt;
}

num-filtered-rows {
    text-color: @fg-alt;
    expand:     false;
}

listview {
    lines:        12;
    columns:      1;
    fixed-height: true;
}

element {
    padding: 10px 12px;
}

element normal.normal {
    background-color: transparent;
}

element alternate.normal {
    background-color: @bg-alt;
}

element selected.normal {
    background-color: @accent;
    text-color:       #ffffff;
}

element-text {
    text-color: inherit;
}
