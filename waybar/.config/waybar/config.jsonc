{
    "layer": "top",
    "position": "bottom",
    "height": 37,
    "spacing": 0,
    "modules-left": ["hyprland/workspaces"],
    "modules-center": ["custom/clock"],
    "modules-right": ["pulseaudio", "battery", "network"],

    "hyprland/workspaces": {
        "disable-scroll": true,
        "format": "{name}",
        "persistent-workspaces": {
            "*": [1, 2, 3, 4, 5]
        }
    },

	"custom/clock": {
    	"exec": "date +'%-I:%M%p %A, %d %b'",
    	"on-click": "gsimplecal",
    	"interval": 1,
    	"format": "<span color='#cec2db'> {}</span>"
	},

    "network": {
        "format-wifi": "<span color='#cec2db'>󰖩 </span><span color='#958e99'>{essid}</span>",
        "format-ethernet": "<span color='#cec2db'>󰈀 </span><span color='#958e99'>ethernet</span>",
        "format-disconnected": "<span color='#cec2db'>󰖪 </span><span color='#958e99'>offline</span>",
        "tooltip": false
    },

    "pulseaudio": {
        "format": "<span color='#49454e'></span><span color='#cec2db'>vol</span> <span color='#958e99'>{volume}%</span>",
        "on-click": "pavucontrol"
    },

    "battery": {
        "format": "<span color='#49454e'>| </span><span color='#cec2db'>bat</span> <span color='#958e99'>{capacity}%</span>",
        "format-charging": "<span color='#49454e'>| </span><span color='#cec2db'>ac:</span> <span color='#958e99'>{capacity}%</span>",
        "states": {
        "critical": 15
    	},
    	"tooltip": false,
    	"interval": 20
    }
}
