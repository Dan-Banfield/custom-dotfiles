{
    "layer": "top",
    "position": "bottom",
    "height": 37,
    "spacing": 0,
    "modules-left": ["hyprland/workspaces", "cpu", "temperature", "custom/gpu-usage", "custom/gpu-temp", "memory"],
    "modules-center": ["custom/clock"],
    "modules-right": ["group/tray-drawer", "pulseaudio", "battery", "network"],

    "hyprland/workspaces": {
        "disable-scroll": true,
        "format": "{name}",
        "persistent-workspaces": {
            "*": [1, 2, 3, 4, 5]
        }
    },

    "cpu": {
        "interval": 2,
        "format": "CPU {usage}%"
    },

    "temperature": {
        "interval": 10,
        "critical-threshold": 80,
        "format": "{temperatureC}°C <span color='#49454e'>│</span>",
        "tooltip": false
    },

    "custom/gpu-usage": {
        "interval": 2,
        "exec": "cat /sys/class/drm/card*/device/gpu_busy_percent 2>/dev/null || echo 0",
        "format": "GPU {}%",
        "tooltip": false
    },

    "custom/gpu-temp": {
        "interval": 10,
        "exec": "sensors 2>/dev/null | grep -m1 'edge' | awk '{print $2}' | tr -d '+' | cut -d. -f1",
        "format": "{}°C <span color='#49454e'>│</span>",
        "tooltip": false
    },

    "memory": {
        "interval": 2,
        "format": "RAM {}%"
    },

	"custom/clock": {
    	"exec": "date +'%-I:%M%p %A, %d %b'",
    	"on-click": "gsimplecal",
    	"interval": 1,
    	"format": "<span color='#cec2db'> {}</span>"
	},

    "network": {
        "format-wifi": "<span color='#cec2db'>󰖩 </span><span color='#958e99'>{essid}</span>",
        "format-ethernet": "<span color='#cec2db'>󰈀 </span><span color='#958e99'>ethernet</span>",
        "format-disconnected": "<span color='#cec2db'>󰖪 </span><span color='#958e99'>offline</span>",
        "tooltip": false
    },

    "pulseaudio": {
        "format": "<span color='#49454e'></span><span color='#cec2db'>vol</span> <span color='#958e99'>{volume}%</span>",
        "on-click": "pavucontrol"
    },

    "group/tray-drawer": {
       "orientation": "horizontal",
       "drawer": {
           "transition-duration": 500,
           "children-class": "collapsed-tray",
           "transition-left-to-right": false,
           "click-to-reveal": false
       },
       "modules": [
           "custom/tray-toggle",
           "tray"
       ]
   },

   "tray": {
        "icon-size": 16,
        "spacing": 10
   },

   "custom/tray-toggle": {
       "format": "^",
       "tooltip": false
   },

    "battery": {
        "format": "<span color='#49454e'>| </span><span color='#cec2db'>bat</span> <span color='#958e99'>{capacity}%</span>",
        "format-charging": "<span color='#49454e'>| </span><span color='#cec2db'>ac:</span> <span color='#958e99'>{capacity}%</span>",
        "states": {
        "critical": 15
    	},
    	"tooltip": false,
    	"interval": 20
    }
}
